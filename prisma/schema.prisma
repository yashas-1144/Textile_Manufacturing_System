
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DISPATCH
  FINANCE
  OPERATOR
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

enum QualityStatus {
  PENDING
  PASSED
  REWORK
  REJECTED
}

enum DispatchStatus {
  PENDING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Buyer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  buyerId     Int
  buyer       Buyer       @relation(fields: [buyerId], references: [id])
  fabricType  String
  colour      String
  quantity    Decimal     @db.Decimal(12, 3)
  unitPrice   Decimal     @db.Decimal(12, 2)
  deadline    DateTime?
  status      OrderStatus @default(PENDING)
  rolls       FinishedRoll[]
  dispatches  Dispatch[]
  expenses    Expense[]
  createdAt   DateTime    @default(now())
}

model FinishedRoll {
  id                 Int           @id @default(autoincrement())
  rollCode           String        @unique
  orderId            Int
  order              Order         @relation(fields: [orderId], references: [id])
  machineCode        String?
  quantity           Decimal       @db.Decimal(12, 3)
  dispatchedQuantity Decimal      @default(0) @db.Decimal(12, 3)
  qualityStatus      QualityStatus @default(PENDING)
  dispatchItems      DispatchItem[]
  createdAt          DateTime      @default(now())

  @@index([orderId, qualityStatus])
}

model Dispatch {
  id           Int            @id @default(autoincrement())
  dispatchNo   String         @unique
  orderId      Int
  order        Order          @relation(fields: [orderId], references: [id])
  status       DispatchStatus @default(PENDING)
  vehicleNo    String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  items        DispatchItem[]
  invoice      Invoice?
  createdAt    DateTime       @default(now())
}

model DispatchItem {
  id         Int          @id @default(autoincrement())
  dispatchId Int
  dispatch   Dispatch     @relation(fields: [dispatchId], references: [id])
  rollId     Int
  roll       FinishedRoll @relation(fields: [rollId], references: [id])
  quantity   Decimal      @db.Decimal(12, 3)

  @@unique([dispatchId, rollId])
}

model Invoice {
  id         Int           @id @default(autoincrement())
  invoiceNo  String        @unique
  dispatchId Int           @unique
  dispatch   Dispatch      @relation(fields: [dispatchId], references: [id])
  subtotal   Decimal       @db.Decimal(12, 2)
  taxAmount  Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  status     InvoiceStatus @default(UNPAID)
  payments   Payment[]
  createdAt  DateTime      @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  paidAt    DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  incurredAt  DateTime @default(now())
}
